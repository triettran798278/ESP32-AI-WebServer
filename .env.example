# Copy this file to .env and replace the blank values for each machine.
# Use a LAN address reachable by the ESP32, not localhost.
HOST_IP=
BRIDGE_SECRET=
API_KEY=

# Optional: auto-bootstrapped console account (password >= 12 chars), native dashboard login, and ThingsBoard defaults.
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=
THINGSBOARD_HOST=https://codehelpers.tech
THINGSBOARD_ALLOWED_ORIGINS=https://codehelpers.tech
THINGSBOARD_API_KEY=

# Optional: CoreIoT integration.
COREIOT_URL=
COREIOT_PUBLIC_ID=
COREIOT_DASHBOARD_ID=
COREIOT_USERNAME=
COREIOT_PASSWORD=
COREIOT_DEVICE_TOKEN=
MCP_ENDPOINT=

# Optional overrides for a proxy or a different public port.
PUBLIC_WS_URL=
PUBLIC_OTA_URL=

# Optional standalone Tasmota simulator settings (export before running it).
TB_HOST=
TB_API_KEY=
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
TB_GATEWAY_TOKEN=
TB_DOWNLINK_CONVERTER_ID=
TASMOTA_FULL_TOPIC=%prefix%/%topic%/
